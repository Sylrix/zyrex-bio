# Copy to .env.local for local development, and add the same value as a
# repository secret named WEB3FORMS_KEY for the GitHub Pages deploy.

# Where orders and contact messages are emailed. Get a free key at
# https://web3forms.com — it is bound to one inbox, so it is safe to expose in
# a static build. Without it the checkout still issues an order reference and
# asks the customer to email it in.
NEXT_PUBLIC_WEB3FORMS_KEY=

# These two must always agree with where the site is actually served.
#
# Currently live at sylrix.github.io/zyrex-bio:
#   NEXT_PUBLIC_BASE_PATH=/zyrex-bio
#   NEXT_PUBLIC_SITE_URL=https://sylrix.github.io/zyrex-bio
#
# Once www.zyrexbioau.com points at GitHub Pages, switch to:
#   NEXT_PUBLIC_BASE_PATH=          (empty)
#   NEXT_PUBLIC_SITE_URL=https://www.zyrexbioau.com
# ...and add a public/CNAME file containing www.zyrexbioau.com
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=
